{
  "manifest_version": 3,
  "name": "Mimir — 浏览历史档案",
  "version": "2.0.0",
  "description": "长期保存浏览历史，搜索与分析，自动备份到自己的 GitHub 私有仓库。",
  "icons": { "16": "icon/icon-16.png", "32": "icon/icon-32.png", "48": "icon/icon-48.png", "128": "icon/icon-128.png" },
  "permissions": ["history", "storage", "alarms", "unlimitedStorage"],
  "host_permissions": ["https://api.github.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Mimir 历史档案", "default_icon": { "16": "icon/icon-16.png", "32": "icon/icon-32.png" } },
  "options_page": "settings.html",
  "incognito": "not_allowed",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
